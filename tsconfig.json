{
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "forceConsistentCasingInFileNames": false,
    "noFallthroughCasesInSwitch": false,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "paths": {
      "@kodi/prisma": ["libs/prisma/src"],
      "@kodi/prisma/*": ["libs/prisma/src/*"],
      "@kodi/prisma-auth": ["libs/prisma/src/aliases/prisma-auth.ts"],
      "@kodi/prisma-users": ["libs/prisma/src/aliases/prisma-users.ts"],
      "@kodi/prisma-city": ["libs/prisma/src/aliases/prisma-city.ts"],
      "@kodi/prisma-core": ["libs/prisma/src/aliases/prisma-core.ts"],
      "@kodi/prisma-notification": ["libs/prisma/src/aliases/prisma-notification.ts"],
      "@kodi/prisma-scheduler": ["libs/prisma/src/aliases/prisma-scheduler.ts"],
      "@kodi/prisma-admin": ["libs/prisma/src/aliases/prisma-admin.ts"],
      "@kodi/prisma-terminal": ["libs/prisma/src/aliases/prisma-terminal.ts"],
      "@kodi/logger": ["libs/logger/src"],
      "@kodi/logger/*": ["libs/logger/src/*"],
      "@kodi/rabbitmq": ["libs/rabbitmq/src"],
      "@kodi/rabbitmq/*": ["libs/rabbitmq/src/*"],
      "@kodi/redis": ["libs/redis/src"],
      "@kodi/redis/*": ["libs/redis/src/*"],
      "@kodi/jwt": ["libs/jwt/src"],
      "@kodi/jwt/*": ["libs/jwt/src/*"],
      "@kodi/interceptors": ["libs/interceptors/src"],
      "@kodi/interceptors/*": ["libs/interceptors/src/*"],
      "@kodi/metrics": ["libs/metrics/src"],
      "@kodi/metrics/*": ["libs/metrics/src/*"],
      "@kodi/config": ["libs/config/src"],
      "@kodi/config/*": ["libs/config/src/*"],
      "@kodi/monitoring": ["libs/monitoring/src"],
      "@kodi/monitoring/*": ["libs/monitoring/src/*"],
      "@kodi/health": ["libs/health/src"],
      "@kodi/health/*": ["libs/health/src/*"],
      "@kodi/errors": ["libs/errors/src"],
      "@kodi/errors/*": ["libs/errors/src/*"],
      "@kodi/rbac": ["libs/rbac/src"],
      "@kodi/rbac/*": ["libs/rbac/src/*"],
      "@kodi/tenancy": ["libs/tenancy/src"],
      "@kodi/tenancy/*": ["libs/tenancy/src/*"],
      "@kodi/contracts": ["libs/contracts/src"],
      "@kodi/contracts/*": ["libs/contracts/src/*"],
      "@kodi/translations": ["libs/translations/src"],
      "@kodi/translations/*": ["libs/translations/src/*"],
      "@kodi/saga": ["libs/saga/src"],
      "@kodi/saga/*": ["libs/saga/src/*"],
      "@kodi/i18n": ["libs/i18n/src"],
      "@kodi/i18n/*": ["libs/i18n/src/*"],
      "@kodi/storage": ["libs/storage/src"],
      "@kodi/storage/*": ["libs/storage/src/*"],
      "@prisma/client-auth": ["./node_modules/.prisma/client-auth"],
      "@prisma/client-users": ["./node_modules/.prisma/client-users"],
      "@prisma/client-city": ["./node_modules/.prisma/client-city"],
      "@prisma/client-core": ["./node_modules/.prisma/client-core"],
      "@prisma/client-notification": ["./node_modules/.prisma/client-notification"],
      "@prisma/client-scheduler": ["./node_modules/.prisma/client-scheduler"],
      "@prisma/client-admin": ["./node_modules/.prisma/client-admin"],
      "@prisma/client-terminal": ["./node_modules/.prisma/client-terminal"]
    }
  },
  "include": ["apps/**/*", "libs/**/*", "scripts/**/*"],
  "exclude": ["node_modules", "dist"]
}
